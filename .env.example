# Base URL of the app
VITE_BASE_URL=http://localhost:3000

# Public Contact Email displayed on the client
VITE_MY_EMAIL=phucnamvan@gmail.com

# ──────────────────────────────────────────────────────────
# SMTP — for the contact form (nodemailer server action)
# Leave blank → emails are logged to server console in dev mode
# ──────────────────────────────────────────────────────────

# ① Gmail (Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx   # 16-character Google App Password
SMTP_FROM="Portfolio Contact" <your_email@gmail.com>

# ② Resend SMTP (Alternative)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxx
# SMTP_FROM="Portfolio Contact" <onboarding@resend.dev>

# ③ Brevo SMTP (Alternative)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM="Portfolio Contact" <your@email.com>
