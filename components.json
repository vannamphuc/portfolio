{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/styles.css",
    "baseColor": "zinc",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "#/components",
    "utils": "#/lib/utils",
    "ui": "#/components/ui",
    "lib": "#/lib",
    "hooks": "#/hooks"
  },
  "iconLibrary": "lucide",
  "registries": {
    "@react-bits": "https://reactbits.dev/r/{name}.json",
    "@uiarc": "https://uiarc.dev/r/{name}.json",
    "@svgl": "https://svgl.app/r/{name}.json",
    "@coss": "https://coss.com/ui/r/{name}.json"
  }
}
